NODE_ENV=production
APP_BASE_URL=https://scansuite.co.zw
API_BASE_URL=https://scansuite.co.zw/api
SEED_ORG_NAME=Scan Suite
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-owner-password

POSTGRES_DB=scansuite
POSTGRES_USER=scansuite
POSTGRES_PASSWORD=replace-with-a-strong-db-password

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PUBLIC_ACCESS_TOKEN_TTL=10m

DATABASE_URL=postgresql://scansuite:replace-with-a-strong-db-password@postgres:5432/scansuite

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-a-strong-minio-access-key
S3_SECRET_KEY=replace-with-a-strong-minio-secret-key
S3_BUCKET=scansuite-files
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=replace-with-a-strong-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-secret-key
MAX_FILE_SIZE_MB=20

API_PORT=4000
CORS_ORIGIN=https://scansuite.co.zw
LOG_LEVEL=info

NEXT_PUBLIC_API_URL=https://scansuite.co.zw
NEXT_PUBLIC_APP_URL=https://scansuite.co.zw
NEXT_PUBLIC_SOCKET_URL=https://scansuite.co.zw

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
